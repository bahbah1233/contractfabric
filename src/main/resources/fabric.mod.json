  "authors": [
    "bayruby"
  ],
  "contact": {
    "homepage": "https://github.com/bahbah1233/contractfabric",
    "sources": "https://github.com/bahbah1233/contractfabric"
  },
  "license": "All Rights Reserved",
  "icon": "assets/contractfabric/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "net.bayruby.contractfabric.ContractFabric"
    ],
    "client": [
      "net.bayruby.contractfabric.ContractFabricClient"
    ]
  },
  "mixins": [
    "contractfabric.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
